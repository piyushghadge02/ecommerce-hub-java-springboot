# Copy to .env and adjust for your machine. Never commit .env.
# Spring Boot maps these automatically (relaxed binding), e.g. SYNC_STRATEGY -> app.sync-strategy.

# --- PostgreSQL (authoritative orders/users) ---
# spring.datasource.url / username / password are set in application.properties;
# override here if needed:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
# SPRING_DATASOURCE_USERNAME=ecom
# SPRING_DATASOURCE_PASSWORD=ecom

# --- MongoDB (product catalog) ---
# SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/ecommerce

# --- Elasticsearch (order search index) ---
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX=orders

# --- Order -> Elasticsearch sync strategy: dual_write | outbox | polling ---
SYNC_STRATEGY=dual_write
OUTBOX_POLL_SECONDS=2
POLLING_INTERVAL_SECONDS=15

# --- Server ---
SERVER_PORT=8000
